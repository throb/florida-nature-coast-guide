# Copy values from Supabase Project Settings -> API.
SUPABASE_URL=

# Supabase now shows this as the publishable key. Older projects may call it anon.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Server-only. Supabase may show this as a secret key or legacy service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# EmailOctopus list signup.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Optional. Leave unset unless you want to force EmailOctopus contact status.
# Valid values depend on EmailOctopus behavior: PENDING or SUBSCRIBED.
EMAILOCTOPUS_STATUS=

# Optional. If set, manual cron calls need Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
